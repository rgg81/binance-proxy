# Copy to .env and adjust as needed. All values shown are the defaults.

# Upstream Binance base URLs
SPOT_BASE_URL=https://api.binance.com
FUTURES_BASE_URL=https://fapi.binance.com

# How long a cached response stays valid before being re-fetched. There is
# no persistence and no history — this is the entire cache policy.
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=5000

# Fraction of Binance's per-minute weight budget we allow ourselves to use
# before proactively throttling outbound requests. 0.8 = stop at 80% used.
RATE_LIMIT_SAFETY_MARGIN=0.8

# Server bind address
HOST=0.0.0.0
PORT=8000

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
